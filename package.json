{
    "name": "@alphanull/payload-plugin-info-tooltip",
    "version": "1.0.0",
    "description": "Shows Payload field descriptions and admin.custom.infoTooltip as an info icon tooltip.",
    "keywords": [
        "payload",
        "payload-plugin",
        "payloadcms",
        "tooltip"
    ],
    "author": {
        "name": "Frank Kudermann",
        "email": "kudermann@alphanull.de",
        "url": "https://alphanull.de"
    },
    "license": "MIT",
    "homepage": "https://github.com/alphanull/payload-plugin-info-tooltip#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/alphanull/payload-plugin-info-tooltip.git"
    },
    "bugs": {
        "url": "https://github.com/alphanull/payload-plugin-info-tooltip/issues"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./client": {
            "types": "./src/client.tsx",
            "default": "./src/client.tsx"
        },
        "./rsc": {
            "types": "./src/rsc.tsx",
            "default": "./src/rsc.tsx"
        },
        "./styles.css": "./src/styles.css"
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "./client": {
                "types": "./dist/client.d.ts",
                "default": "./dist/client.js"
            },
            "./rsc": {
                "types": "./dist/rsc.d.ts",
                "default": "./dist/rsc.js"
            },
            "./styles.css": "./dist/styles.css"
        }
    },
    "scripts": {
        "build": "pnpm lint && pnpm test && node scripts/build.mjs",
        "lint": "eslint . && stylelint \"src/**/*.css\"",
        "test": "vitest run",
        "prepublishOnly": "pnpm build"
    },
    "peerDependencies": {
        "@payloadcms/translations": "^3.90.2 || ^4.0.0-0",
        "@payloadcms/ui": "^3.90.2 || ^4.0.0-0",
        "payload": "^3.90.2 || ^4.0.0-0",
        "react": "^19",
        "react-dom": "^19"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@payloadcms/translations": "3.90.2",
        "@payloadcms/ui": "3.90.2",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/stylelint-plugin": "^5.3.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "esbuild": "0.28.1",
        "eslint": "^10.12.0",
        "eslint-plugin-jsdoc": "^65.3.6",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "payload": "3.90.2",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "stylelint": "^17.16.0",
        "stylelint-order": "^8.1.2",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.71.2",
        "vitest": "5.0.5"
    }
}
